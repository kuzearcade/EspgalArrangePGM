; espgalarr lossless BGM: the PGM Z80 sound driver's song start / stop / fade drive the enhanced
; hardware's ADX stream player at Z80 I/O 0x8800 (MiSTer core rtl/adx_stream.sv, MAME
; espgalarr_bgm.cpp) instead of an ICS2115 voice. Assembled by espgalarr/pgm/z80.py
; (build_blob_adx); the track table maps the 68k BGM index to a track of the BGM blob.
;
; Port 0x8800 W track; 0x8801 W command (1 play, 2 stop, 3 pause, 4 resume, 5 fade out);
; 0x8802 / 0x8803 W volume left / right (0x80 = unity).
;
; The player does the PS2's volume and fades itself (a play request while a stream plays fades
; that one out first; a fade lasts 55 frames). A BGM index with no track (0xff: the PS2's 1 s
; silent clip, cmd 14, and the stream-index-0 commands) fades the running stream out.
;
; Entry points (the driver's C functions are redirected here with JP):
;   stream_play : HL = BGM index (68k command id), DE = mode (ignored)
;   stream_stop : stop the stream
;   stream_fade : fade the stream out

    .org STREAM_ORG

stream_play:
    push af
    push bc
    push hl
    ld a,l
    cp N_TRACKS
    jr nc,play_none
    ld c,a
    ld b,0
    ld hl,track_table
    add hl,bc
    ld a,(hl)
    cp $ff
    jr z,play_none
    ld bc,$8800
    out (c),a            ; track
    ld a,$80
    ld bc,$8802
    out (c),a            ; volume left
    inc c
    out (c),a            ; volume right
    ld a,1
    ld bc,$8801
    out (c),a            ; play
    jr play_done
play_none:
    ld a,5
    ld bc,$8801
    out (c),a            ; fade out
play_done:
    pop hl
    pop bc
    pop af
    ret

stream_stop:
    push af
    push bc
    ld a,2
    ld bc,$8801
    out (c),a
    pop bc
    pop af
    ret

stream_fade:
    push af
    push bc
    ld a,5
    ld bc,$8801
    out (c),a
    pop bc
    pop af
    ret

track_table:
