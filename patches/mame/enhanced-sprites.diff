+// espgalarr: DDP2 cart + enhanced sprite engine + enhanced RAM. Sprites beyond the 256-entry main list
+// continue in a list in the cart's ARM shared RAM at 68k 0xD0C840 (10 bytes per entry, same
+// format, terminator = size word 0). Up to 1400 extra entries (list ends below the 0xD10000 latch).
+u16 pgm_arm_type2_state::espgalarr_extsprites_r(offs_t offset)
+{
+	return arm7_ram_r(((0xd0c840 - 0xd00000) / 2 + offset) & 0x7fff);
+}
+
+// espgalarr enhanced RAM: 128 KB of extra work RAM at 0xE00000 (unmapped on a stock PGM) for
+// the Arrange-sized sprite lists, pools and item slots.
+void pgm_arm_type2_state::espgalarr_mem(address_map &map)
+{
+	kov2_mem(map);
+	map(0xe00000, 0xe1ffff).ram().share("enhanced_ram");
+}
+
+// espgalarr enhanced sound: the PS2 Arrange soundtrack streamed at Z80 I/O 0x8800 (espgalarr_bgm.cpp)
+void pgm_arm_type2_state::espgalarr_z80_io(address_map &map)
+{
+	pgm_z80_io(map);
+	map(0x8800, 0x880f).rw("bgm_stream", FUNC(espgalarr_bgm_device::read), FUNC(espgalarr_bgm_device::write));
+}
+
+void pgm_arm_type2_state::espgalarr(machine_config &config)
+{
+	pgm_arm_type2(config);
+	m_maincpu->set_addrmap(AS_PROGRAM, &pgm_arm_type2_state::espgalarr_mem);
+	subdevice<cpu_device>("soundcpu")->set_addrmap(AS_IO, &pgm_arm_type2_state::espgalarr_z80_io);
+	SPEAKER(config, "bgm_speaker", 2).front();
+	espgalarr_bgm_device &bgm(ESPGALARR_BGM(config, "bgm_stream"));
+	bgm.add_route(0, "bgm_speaker", 0.5, 0);
+	bgm.add_route(1, "bgm_speaker", 0.5, 1);
+	igs023_video_device &video = *subdevice<igs023_video_device>("igs023");
+	video.set_extended_sprites(1400);
+	video.read_spriteram_ext_callback().set(FUNC(pgm_arm_type2_state::espgalarr_extsprites_r));
+}
+
 void pgm_arm_type2_state::pgm_arm_type2_22m(machine_config &config) // ARM7 uses 22MHz XTAL (martmast dw2001 dwpc)
