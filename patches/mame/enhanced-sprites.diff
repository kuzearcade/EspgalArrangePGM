@@ -0,0 +1,38 @@
+// license:BSD-3-Clause
+// espgalarr enhanced hardware: the PS2 Arrange soundtrack streamed from the "bgm" region (not a
+// real PGM device; the MiSTer core's rtl/adx_stream.sv is the same player)
+#ifndef MAME_IGS_ESPGALARR_BGM_H
+#define MAME_IGS_ESPGALARR_BGM_H
+
+#pragma once
+
+class espgalarr_bgm_device : public device_t, public device_sound_interface
+{
+public:
+	espgalarr_bgm_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock = 48000);
+
+	u8 read(offs_t offset);
+	void write(offs_t offset, u8 data);
+
+protected:
+	virtual void device_start() override ATTR_COLD;
+	virtual void device_reset() override ATTR_COLD;
+	virtual void sound_stream_update(sound_stream &stream) override;
+
+private:
+	void play(int track);
+	bool decode(s16 &l, s16 &r);
+	u32 be32(u32 a) const;
+
+	required_region_ptr<u8> m_rom;
+	sound_stream *m_stream;
+
+	u8 m_track, m_vol_l, m_vol_r;
+	bool m_playing, m_paused, m_looped, m_loop, m_saved;
+	u32 m_data, m_samples, m_loop_start, m_loop_end, m_pos;
+	s16 m_hist[2][2], m_saved_hist[2][2];
+};
+
+DECLARE_DEVICE_TYPE(ESPGALARR_BGM, espgalarr_bgm_device)
+
+#endif // MAME_IGS_ESPGALARR_BGM_H
