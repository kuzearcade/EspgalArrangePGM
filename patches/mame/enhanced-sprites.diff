diff --git a/src/mame/igs/espgalarr_bgm.cpp b/src/mame/igs/espgalarr_bgm.cpp
new file mode 100644
index 00000000000..bbecaa45628
--- /dev/null
+++ b/src/mame/igs/espgalarr_bgm.cpp
@@ -0,0 +1,162 @@
+// license:BSD-3-Clause
+/*
+  espgalarr enhanced hardware: BGM stream player (Z80 I/O 0x8800-0x880F)
+
+  The "bgm" region holds "EBGM", a track count, then (offset, size) big-endian per track, each
+  track a CRI ADX stream (encoding 3, 4-bit, 18-byte frames, 2 channels, 48 kHz, header
+  version 4). Decoded with the PS2's arithmetic (CRI ADXB): per sample
+      s = clamp16(((c1 * h1 + c2 * h2) >> 12) + nibble * ((word & 0x1fff) + 1))
+  with c1 / c2 = 7400 / -3342; at the loop end the stream jumps to the loop start with the
+  predictor history saved there (as the PS2 does).
+
+  Registers: 0 W track, R status (bit 0 playing, bit 1 looped, bit 2 paused); 1 W command
+  (1 play, 2 stop, 3 pause, 4 resume); 2 / 3 W volume left / right (0x80 = unity).
+*/
+
+#include "emu.h"
+#include "espgalarr_bgm.h"
+
+DEFINE_DEVICE_TYPE(ESPGALARR_BGM, espgalarr_bgm_device, "espgalarr_bgm", "espgalarr BGM stream")
+
+static constexpr int C1 = 7400, C2 = -3342;
+
+espgalarr_bgm_device::espgalarr_bgm_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock)
+	: device_t(mconfig, ESPGALARR_BGM, tag, owner, clock)
+	, device_sound_interface(mconfig, *this)
+	, m_rom(*this, DEVICE_SELF)
+	, m_stream(nullptr)
+{
+}
+
+void espgalarr_bgm_device::device_start()
+{
+	m_stream = stream_alloc(0, 2, clock());
+	save_item(NAME(m_track)); save_item(NAME(m_vol_l)); save_item(NAME(m_vol_r));
+	save_item(NAME(m_playing)); save_item(NAME(m_paused)); save_item(NAME(m_looped));
+	save_item(NAME(m_loop)); save_item(NAME(m_saved));
+	save_item(NAME(m_data)); save_item(NAME(m_samples)); save_item(NAME(m_loop_start));
+	save_item(NAME(m_loop_end)); save_item(NAME(m_pos));
+	save_item(NAME(m_hist)); save_item(NAME(m_saved_hist));
+}
+
+void espgalarr_bgm_device::device_reset()
+{
+	m_track = 0; m_vol_l = m_vol_r = 0x80;
+	m_playing = m_paused = m_looped = m_loop = m_saved = false;
+	m_data = m_samples = m_loop_start = m_loop_end = m_pos = 0;
+	memset(m_hist, 0, sizeof(m_hist));
+	memset(m_saved_hist, 0, sizeof(m_saved_hist));
+}
+
+u32 espgalarr_bgm_device::be32(u32 a) const
+{
+	if (a + 4 > m_rom.length())
+		return 0;
+	return (m_rom[a] << 24) | (m_rom[a + 1] << 16) | (m_rom[a + 2] << 8) | m_rom[a + 3];
+}
+
+void espgalarr_bgm_device::play(int track)
+{
+	m_playing = false;
+	m_looped = false;
+	if (m_rom.length() < 8 || be32(0) != 0x4542474d || track >= int(be32(4)))   // "EBGM"
+		return;
+	u32 base = be32(8 + 8 * track);
+	if (base + 0x40 > m_rom.length() || m_rom[base] != 0x80 || m_rom[base + 1] != 0x00 ||
+			m_rom[base + 4] != 3 || m_rom[base + 5] != 18 || m_rom[base + 6] != 4 || m_rom[base + 7] != 2)
+		return;
+	m_data = base + ((m_rom[base + 2] << 8) | m_rom[base + 3]) + 4;
+	m_samples = be32(base + 0x0c);
+	m_loop = be32(base + 0x24) != 0;
+	m_loop_start = be32(base + 0x28);
+	m_loop_end = be32(base + 0x30);
+	m_pos = 0;
+	m_saved = false;
+	memset(m_hist, 0, sizeof(m_hist));
+	m_playing = true;
+}
+
+bool espgalarr_bgm_device::decode(s16 &l, s16 &r)
+{
+	u32 end = m_loop ? m_loop_end : m_samples;
+	if (m_pos == end)
+	{
+		if (!m_loop)
+		{
+			m_playing = false;
+			return false;
+		}
+		m_pos = m_loop_start;
+		memcpy(m_hist, m_saved_hist, sizeof(m_hist));
+		m_looped = true;
+	}
+	if (m_loop && m_pos == m_loop_start && !m_saved)
+	{
+		memcpy(m_saved_hist, m_hist, sizeof(m_hist));
+		m_saved = true;
+	}
+	u32 f = m_pos >> 5, i = m_pos & 31;
+	s16 out[2];
+	for (int c = 0; c < 2; c++)
+	{
+		u32 o = m_data + (f * 2 + c) * 18;
+		if (o + 18 > m_rom.length())
+		{
+			m_playing = false;
+			return false;
+		}
+		int scale = (((m_rom[o] << 8) | m_rom[o + 1]) & 0x1fff) + 1;
+		u8 b = m_rom[o + 2 + i / 2];
+		int nib = (i & 1) ? (b & 0xf) : (b >> 4);
+		if (nib > 7) nib -= 16;
+		s32 s = ((C1 * m_hist[c][0] + C2 * m_hist[c][1]) >> 12) + nib * scale;
+		s = std::clamp<s32>(s, -32768, 32767);
+		m_hist[c][1] = m_hist[c][0];
+		m_hist[c][0] = s;
+		out[c] = s;
+	}
+	m_pos++;
+	l = out[0];
+	r = out[1];
+	return true;
+}
+
+void espgalarr_bgm_device::sound_stream_update(sound_stream &stream)
+{
+	for (int n = 0; n < stream.samples(); n++)
+	{
+		s16 l = 0, r = 0;
+		if (m_playing && !m_paused && !decode(l, r))
+			l = r = 0;
+		stream.put_int(0, n, (s32(l) * m_vol_l) >> 7, 32768);
+		stream.put_int(1, n, (s32(r) * m_vol_r) >> 7, 32768);
+	}
+}
+
+u8 espgalarr_bgm_device::read(offs_t offset)
+{
+	m_stream->update();
+	if ((offset & 0xf) == 0)
+		return (m_playing ? 1 : 0) | (m_looped ? 2 : 0) | (m_paused ? 4 : 0);
+	return 0xff;
+}
+
+void espgalarr_bgm_device::write(offs_t offset, u8 data)
+{
+	m_stream->update();
+	switch (offset & 0xf)
+	{
+	case 0: m_track = data; break;
+	case 1:
+		switch (data)
+		{
+		case 1: play(m_track); m_paused = false; break;
+		case 2: m_playing = false; break;
+		case 3: m_paused = true; break;
+		case 4: m_paused = false; break;
+		}
+		break;
+	case 2: m_vol_l = data; break;
+	case 3: m_vol_r = data; break;
+	}
+}
