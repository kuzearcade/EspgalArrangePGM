diff --git a/pcsx2/EspgalTrace.cpp b/pcsx2/EspgalTrace.cpp
new file mode 100644
index 000000000..4f81db7cd
--- /dev/null
+++ b/pcsx2/EspgalTrace.cpp
@@ -0,0 +1,327 @@
+// SPDX-License-Identifier: GPL-3.0+
+#include "EspgalTrace.h"
+#include "Memory.h"
+#include "R5900.h"
+#include "MTGS.h"
+#include "GS/GS.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <set>
+#include <string>
+#include <vector>
+#include <utility>
+#include <unordered_map>
+#include <zstd.h>
+
+namespace
+{
+	bool s_init = false;
+	bool s_pad = false;
+	std::vector<std::pair<u32, u32>> s_padScript; // (frame, pressed mask)
+	std::set<u32> s_dumps;
+	std::set<u32> s_snaps;
+	std::string s_dir = ".";
+	u32 s_quit = 0;
+	u32 s_frame = 0;
+	u32 s_mask = 0;
+	struct Hook
+	{
+		std::vector<u8> sig;
+		u32 hits = 0;
+	};
+	std::unordered_map<u32, std::vector<Hook>> s_hooks; // several overlays can share an address
+	u32 s_hookMax = 4;
+	std::vector<std::pair<u32, std::vector<u8>>> s_pokes;
+	u32 s_pokeFrom = 0;
+	// one-shot pokes: written once, at the first frame whose watched bytes equal s_poke1When
+	std::vector<std::pair<u32, std::vector<u8>>> s_pokes1;
+	std::pair<u32, std::vector<u8>> s_poke1When;
+	bool s_poke1Done = false;
+	u32 s_poke1From = 0; // ESPGAL_POKE1_FROM: not before this frame
+	std::vector<std::pair<u32, u32>> s_watch; // (address, length)
+	u32 s_watchFrom = 0, s_watchTo = 0xffffffffu;
+	FILE* s_watchFile = nullptr;
+	bool s_hookWatch = false; // hooks print the watch bytes instead of dumping
+
+	// "addr:hex,addr:hex": EE RAM addresses and the bytes (memory order) to write there
+	void ParsePokes(const std::string& s, std::vector<std::pair<u32, std::vector<u8>>>& out)
+	{
+		size_t pos = 0;
+		while (pos < s.size())
+		{
+			size_t e = s.find(',', pos);
+			std::string item = s.substr(pos, e == std::string::npos ? std::string::npos : e - pos);
+			const size_t colon = item.find(':');
+			if (colon != std::string::npos)
+			{
+				std::vector<u8> bytes;
+				const std::string hex = item.substr(colon + 1);
+				for (size_t i = 0; i + 1 < hex.size(); i += 2)
+					bytes.push_back(static_cast<u8>(std::strtoul(hex.substr(i, 2).c_str(), nullptr, 16)));
+				out.emplace_back(static_cast<u32>(std::strtoul(item.substr(0, colon).c_str(), nullptr, 16)), std::move(bytes));
+			}
+			if (e == std::string::npos)
+				break;
+			pos = e + 1;
+		}
+	}
+
+	void Init()
+	{
+		s_init = true;
+		if (const char* p = std::getenv("ESPGAL_PAD"))
+		{
+			if (FILE* f = std::fopen(p, "r"))
+			{
+				unsigned fr, m;
+				while (std::fscanf(f, "%u %x", &fr, &m) == 2)
+					s_padScript.emplace_back(fr, m);
+				std::fclose(f);
+				s_pad = true;
+			}
+		}
+		if (const char* d = std::getenv("ESPGAL_DUMP"))
+		{
+			std::string s(d);
+			size_t pos = 0;
+			while (pos < s.size())
+			{
+				size_t e = s.find(',', pos);
+				s_dumps.insert(static_cast<u32>(std::strtoul(s.substr(pos, e - pos).c_str(), nullptr, 10)));
+				if (e == std::string::npos)
+					break;
+				pos = e + 1;
+			}
+		}
+		if (const char* d = std::getenv("ESPGAL_SNAP"))
+		{
+			std::string s(d);
+			size_t pos = 0;
+			while (pos < s.size())
+			{
+				size_t e = s.find(',', pos);
+				s_snaps.insert(static_cast<u32>(std::strtoul(s.substr(pos, e - pos).c_str(), nullptr, 10)));
+				if (e == std::string::npos)
+					break;
+				pos = e + 1;
+			}
+		}
+		if (const char* d = std::getenv("ESPGAL_DUMP_DIR"))
+			s_dir = d;
+		if (const char* hf = std::getenv("ESPGAL_HOOKS"))
+		{
+			if (FILE* f = std::fopen(hf, "r"))
+			{
+				char line[512];
+				while (std::fgets(line, sizeof(line), f))
+				{
+					unsigned pc;
+					char sig[256] = {};
+					if (std::sscanf(line, "%x %255s", &pc, sig) < 1)
+						continue;
+					Hook h;
+					for (size_t i = 0; sig[i] && sig[i + 1]; i += 2)
+					{
+						char b[3] = {sig[i], sig[i + 1], 0};
+						h.sig.push_back(static_cast<u8>(std::strtoul(b, nullptr, 16)));
+					}
+					s_hooks[pc].push_back(std::move(h));
+				}
+				std::fclose(f);
+			}
+		}
+		if (const char* m = std::getenv("ESPGAL_HOOK_MAX"))
+			s_hookMax = static_cast<u32>(std::strtoul(m, nullptr, 10));
+		if (const char* pk = std::getenv("ESPGAL_POKE"))
+			ParsePokes(pk, s_pokes);
+		if (const char* pk = std::getenv("ESPGAL_POKE1"))
+			ParsePokes(pk, s_pokes1);
+		if (const char* pw = std::getenv("ESPGAL_POKE1_WHEN"))
+		{
+			std::vector<std::pair<u32, std::vector<u8>>> w;
+			ParsePokes(pw, w);
+			if (!w.empty())
+				s_poke1When = w[0];
+		}
+		if (const char* pf = std::getenv("ESPGAL_POKE1_FROM"))
+			s_poke1From = static_cast<u32>(std::strtoul(pf, nullptr, 10));
+		if (const char* pf = std::getenv("ESPGAL_POKE_FROM"))
+			s_pokeFrom = static_cast<u32>(std::strtoul(pf, nullptr, 10));
+		if (const char* wv = std::getenv("ESPGAL_WATCH"))
+		{
+			std::string s(wv);
+			size_t pos = 0;
+			while (pos < s.size())
+			{
+				size_t e = s.find(',', pos);
+				std::string item = s.substr(pos, e == std::string::npos ? std::string::npos : e - pos);
+				const size_t colon = item.find(':');
+				if (colon != std::string::npos)
+					s_watch.emplace_back(static_cast<u32>(std::strtoul(item.substr(0, colon).c_str(), nullptr, 16)),
+						static_cast<u32>(std::strtoul(item.substr(colon + 1).c_str(), nullptr, 16)));
+				if (e == std::string::npos)
+					break;
+				pos = e + 1;
+			}
+		}
+		s_hookWatch = std::getenv("ESPGAL_HOOK_WATCH") != nullptr;
+		if (const char* wr = std::getenv("ESPGAL_WATCH_RANGE"))
+			std::sscanf(wr, "%u-%u", &s_watchFrom, &s_watchTo);
+		if (const char* q = std::getenv("ESPGAL_QUIT"))
+			s_quit = static_cast<u32>(std::strtoul(q, nullptr, 10));
+	}
+
+	void WriteFile(const std::string& name, const void* data, size_t size)
+	{
+		if (FILE* f = std::fopen((s_dir + "/" + name).c_str(), "wb"))
+		{
+			std::fwrite(data, 1, size, f);
+			std::fclose(f);
+		}
+	}
+} // namespace
+
+void EspgalTrace::OnVSync()
+{
+	if (!s_init)
+		Init();
+	s_frame++;
+	if (s_pad)
+	{
+		for (const auto& [fr, m] : s_padScript)
+			if (fr <= s_frame)
+				s_mask = m;
+	}
+	if (s_frame >= s_pokeFrom)
+	{
+		for (const auto& [addr, bytes] : s_pokes)
+		{
+			const u32 off = addr & (Ps2MemSize::MainRam - 1);
+			if (off + bytes.size() <= Ps2MemSize::MainRam)
+				std::memcpy(eeMem->Main + off, bytes.data(), bytes.size());
+		}
+	}
+	if (!s_poke1Done && !s_pokes1.empty() && s_frame >= s_poke1From)
+	{
+		const auto& [waddr, wbytes] = s_poke1When;
+		const u32 woff = waddr & (Ps2MemSize::MainRam - 1);
+		if (woff + wbytes.size() <= Ps2MemSize::MainRam && std::memcmp(eeMem->Main + woff, wbytes.data(), wbytes.size()) == 0)
+		{
+			s_poke1Done = true;
+			for (const auto& [addr, bytes] : s_pokes1)
+			{
+				const u32 off = addr & (Ps2MemSize::MainRam - 1);
+				if (off + bytes.size() <= Ps2MemSize::MainRam)
+					std::memcpy(eeMem->Main + off, bytes.data(), bytes.size());
+			}
+			std::fprintf(stderr, "ESPGAL poke1 at frame %u\n", s_frame);
+		}
+	}
+	if (s_dumps.count(s_frame))
+	{
+		const std::string n = std::to_string(s_frame);
+		WriteFile("ee_" + n + ".bin", eeMem->Main, Ps2MemSize::MainRam);
+		WriteFile("spr_" + n + ".bin", eeMem->Scratch, Ps2MemSize::Scratch);
+		WriteFile("regs_" + n + ".bin", &cpuRegs, sizeof(cpuRegs));
+		std::fprintf(stderr, "ESPGAL: dumped frame %u (EE pc %08x)\n", s_frame, cpuRegs.pc);
+	}
+	if (!s_watch.empty() && s_frame >= s_watchFrom && s_frame <= s_watchTo)
+	{
+		if (!s_watchFile)
+			s_watchFile = std::fopen((s_dir + "/watch.txt").c_str(), "w");
+		if (s_watchFile)
+		{
+			std::fprintf(s_watchFile, "%u", s_frame);
+			for (const auto& [addr, len] : s_watch)
+			{
+				std::fputc(' ', s_watchFile);
+				const u32 off = addr & (Ps2MemSize::MainRam - 1);
+				for (u32 i = 0; i < len && off + i < Ps2MemSize::MainRam; i++)
+					std::fprintf(s_watchFile, "%02x", eeMem->Main[off + i]);
+			}
+			std::fputc('\n', s_watchFile);
+		}
+	}
+	if (s_snaps.count(s_frame))
+	{
+		std::string path = s_dir + "/snap_" + std::to_string(s_frame) + ".png";
+		MTGS::RunOnGSThread([path]() { GSQueueSnapshot(path, 0); });
+	}
+	if (s_quit && s_frame >= s_quit)
+	{
+		std::fprintf(stderr, "ESPGAL: quit at frame %u\n", s_frame);
+		std::fflush(nullptr);
+		std::_Exit(0);
+	}
+}
+
+bool EspgalTrace::PadActive()
+{
+	if (!s_init)
+		Init();
+	return s_pad;
+}
+
+u32 EspgalTrace::PadButtons()
+{
+	return (~s_mask) & 0xffffu;
+}
+
+bool EspgalTrace::IsHook(u32 pc)
+{
+	if (!s_init)
+		Init();
+	return !s_hooks.empty() && s_hooks.count(pc) != 0;
+}
+
+void EspgalTrace::OnHook()
+{
+	const u32 pc = cpuRegs.pc;
+	auto it = s_hooks.find(pc);
+	if (it == s_hooks.end())
+		return;
+	const u32 off = pc & (Ps2MemSize::MainRam - 1);
+	if (s_hookWatch)
+	{
+		if (s_frame < s_watchFrom || s_frame > s_watchTo)
+			return;
+		if (!s_watchFile)
+			s_watchFile = std::fopen((s_dir + "/watch.txt").c_str(), "w");
+		if (s_watchFile)
+		{
+			std::fprintf(s_watchFile, "H %u %08x", s_frame, pc);
+			for (const auto& [addr, len] : s_watch)
+			{
+				std::fputc(' ', s_watchFile);
+				const u32 o = addr & (Ps2MemSize::MainRam - 1);
+				for (u32 i = 0; i < len && o + i < Ps2MemSize::MainRam; i++)
+					std::fprintf(s_watchFile, "%02x", eeMem->Main[o + i]);
+			}
+			std::fprintf(s_watchFile, " ra=%08x", cpuRegs.GPR.n.ra.UL[0]);
+			std::fputc('\n', s_watchFile);
+		}
+		return;
+	}
+	for (size_t si = 0; si < it->second.size(); si++)
+	{
+		Hook& h = it->second[si];
+		if (h.hits >= s_hookMax)
+			continue;
+		if (off + h.sig.size() > Ps2MemSize::MainRam || std::memcmp(eeMem->Main + off, h.sig.data(), h.sig.size()) != 0)
+			continue; // another overlay's code at this address
+		const u32 n = h.hits++;
+		char base[64];
+		std::snprintf(base, sizeof(base), "hook_%08x_%zu_%u", pc, si, n);
+		const size_t cap = ZSTD_compressBound(Ps2MemSize::MainRam);
+		std::vector<u8> buf(cap);
+		const size_t sz = ZSTD_compress(buf.data(), cap, eeMem->Main, Ps2MemSize::MainRam, 1);
+		if (!ZSTD_isError(sz))
+			WriteFile(std::string(base) + ".ee.zst", buf.data(), sz);
+		WriteFile(std::string(base) + ".spr", eeMem->Scratch, Ps2MemSize::Scratch);
+		WriteFile(std::string(base) + ".regs", &cpuRegs, sizeof(cpuRegs));
+		std::fprintf(stderr, "ESPGAL: hook %08x sig %zu #%u at frame %u\n", pc, si, n, s_frame);
+		return;
+	}
+}
diff --git a/pcsx2/EspgalTrace.h b/pcsx2/EspgalTrace.h
new file mode 100644
index 000000000..fc3a3fe35
--- /dev/null
+++ b/pcsx2/EspgalTrace.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-3.0+
+// espgalarr test automation (environment-driven, inert unless the variables are set):
+//   ESPGAL_PAD=file      lines "frame hexmask": pad 1 buttons pressed from that frame on
+//                        (bit numbers as PadDualshock2: 0 L2 1 R2 2 L1 3 R1 4 Tri 5 Cir 6 Cro 7 Sq
+//                         8 Sel 9 L3 10 R3 11 Start 12 Up 13 Right 14 Down 15 Left)
+//   ESPGAL_DUMP=f1,f2..  frames at which to dump EE RAM, scratchpad and EE registers
+//   ESPGAL_DUMP_DIR=dir  where dumps go (ee_<frame>.bin, spr_<frame>.bin, regs_<frame>.bin)
+//   ESPGAL_SNAP=f1,f2..  frames at which to save a screenshot (snap_<frame>.png)
+//   ESPGAL_POKE=a:hex,.. EE RAM bytes written every frame from ESPGAL_POKE_FROM (memory order)
+//   ESPGAL_POKE1=a:hex,.. EE RAM bytes written once, at the first frame (not before
+//                        ESPGAL_POKE1_FROM) whose bytes at ESPGAL_POKE1_WHEN=a:hex match
+//                        (a play counter value: the same game step as a MAME Lua poke)
+//   ESPGAL_WATCH=a:len,.. EE RAM bytes (hex address:hex length) printed every frame to
+//                        ESPGAL_DUMP_DIR/watch.txt ("frame hex hex ..."), within
+//   ESPGAL_WATCH_RANGE=from-to (frames)
+//   ESPGAL_QUIT=frame    exit the process after that frame
+//   ESPGAL_HOOKS=file    lines "hexpc hexbytes": EE recompiler calls OnHook at that pc when the
+//                        code there starts with those bytes (stage overlays share addresses);
+//                        each hit dumps zstd EE RAM + raw scratchpad + raw cpuRegs to
+//                        ESPGAL_DUMP_DIR/hook_<pc>_<sig>_<n>.{ee.zst,spr,regs}
+//                        (<sig> = index among the lines for that pc, in file order)
+//   ESPGAL_HOOK_MAX=n    dumps per hook address (default 4)
+//   ESPGAL_HOOK_WATCH=1  hooks append "H frame pc <watch bytes>" to watch.txt (within the
+//                        watch range) instead of dumping
+#pragma once
+#include "common/Pcsx2Types.h"
+
+namespace EspgalTrace
+{
+	void OnVSync();
+	bool PadActive();
+	u32 PadButtons(); // active-low, as PadDualshock2::GetButtons
+	bool IsHook(u32 pc); // compile time (recompiler)
+	void OnHook();       // run time, cpuRegs flushed
+}
